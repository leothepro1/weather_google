# =====================================================================
# Weather Budget Modifier — environment variables
# =====================================================================
# This file documents every var the project uses. Copy to .env (or set
# via `wrangler secret put` / Cloudflare dashboard) for real values.
# Phase 0 only uses ADMIN_TOKEN and VITE_API_URL.
# =====================================================================

# ---- API (apps/api, Cloudflare Worker) ----
# Bearer token required on all API routes except /health.
# Set via: wrangler secret put ADMIN_TOKEN
ADMIN_TOKEN=replace-me-with-a-long-random-string

# Fixed geographic location used by the weather client.
# Declared as [vars] in wrangler.toml (non-secret).
WEATHER_LAT=59.3293
WEATHER_LON=18.0686

# ---- Google Ads / OAuth (apps/api — Phase 1) ----
# Registered here so env typing and wrangler config are ready. No routes
# consume these in Phase 0. Secrets go via `wrangler secret put` in prod
# and via `apps/api/.dev.vars` (gitignored) locally. Non-secrets may
# alternatively live in wrangler.toml `[vars]`.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/auth/google/callback

# Mock-vs-real toggle and web origin for CORS.
USE_MOCK_GOOGLE_ADS=true
WEB_ORIGIN=http://localhost:3000

# ---- Web (apps/web, Vite) ----
# Base URL of the API. Vite exposes VITE_*-prefixed vars to the browser.
VITE_API_URL=http://127.0.0.1:8787
