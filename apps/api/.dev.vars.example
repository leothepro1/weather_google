# Copy to `apps/api/.dev.vars` (gitignored) and fill in real values for
# local `wrangler dev`. In production, use `wrangler secret put <NAME>`
# for each of the secret fields.
#
# Secret:     GOOGLE_ADS_DEVELOPER_TOKEN, GOOGLE_OAUTH_CLIENT_SECRET
# Not secret: GOOGLE_OAUTH_CLIENT_ID, GOOGLE_ADS_LOGIN_CUSTOMER_ID,
#             GOOGLE_ADS_CUSTOMER_ID, GOOGLE_OAUTH_REDIRECT_URI

ADMIN_TOKEN=dev-token

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/auth/google/callback
